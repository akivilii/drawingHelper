<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>DrawingHelperSetup</AssemblyName>
    <ApplicationIcon>..\DrawingHelper.App\Assets\app_icon.ico</ApplicationIcon>
    <Optimize>true</Optimize>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <Version>1.0.2</Version>
    <AssemblyVersion>1.0.2.0</AssemblyVersion>
    <FileVersion>1.0.2.0</FileVersion>
    <Product>DrawingHelper Installer</Product>
    <Company>akivilii</Company>
    <Authors>akivilii</Authors>
    <Description>Windows Installer for Minecraft DrawingHelper.</Description>
    <Copyright>Copyright (c) 2026 akivilii</Copyright>
    <RepositoryUrl>https://github.com/akivilii/drawingHelper</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="..\DrawingHelper.App\Assets\app_icon.ico" Link="Assets\app_icon.ico" />
    <Resource Include="..\DrawingHelper.App\Assets\app_icon.png" Link="Assets\app_icon.png" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Payload\app_payload.zip"
                      LogicalName="DrawingHelper.Setup.app_payload.zip"
                      Condition="Exists('Payload\app_payload.zip')" />
  </ItemGroup>
</Project>
