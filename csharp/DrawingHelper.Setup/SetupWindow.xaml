<Window x:Class="DrawingHelper.Setup.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DrawingHelper 설치"
        Icon="pack://application:,,,/Assets/app_icon.ico"
        Background="White"
        FontFamily="Segoe UI, Malgun Gothic"
        FontSize="12"
        Width="540" Height="400"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

    <DockPanel LastChildFill="True">
        <!-- Bottom Wizard Navigation Bar -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource BgBottom}"
                BorderBrush="{StaticResource BorderLine}" BorderThickness="0,1,0,0" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="DrawingHelper v1.0.1" FontSize="11"
                           Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnBack" Content="&lt; 이전" Click="OnBackClick" Margin="0,0,6,0" Visibility="Collapsed"/>
                    <Button x:Name="BtnNext" Content="다음 &gt;" Style="{StaticResource PrimaryBtn}" Click="OnNextClick"/>
                    <Button x:Name="BtnCancel" Content="취소" Click="OnCancelClick" Margin="14,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Body: Left Brand Panel + Right Step Content -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="155"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Brand Sidebar -->
            <Border Grid.Column="0" Background="{StaticResource BgPanel}"
                    BorderBrush="{StaticResource DarkBorderLine}" BorderThickness="0,0,1,0" Padding="16,20">
                <StackPanel HorizontalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/app_icon.png" Width="80" Height="80"
                           RenderOptions.BitmapScalingMode="HighQuality" Margin="0,4,0,12"/>
                    <TextBlock Text="DrawingHelper" FontSize="14" FontWeight="Bold"
                               Foreground="{StaticResource SidebarText}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Minecraft Pixel Helper" FontSize="10.5"
                               Foreground="{StaticResource SidebarMuted}"
                               HorizontalAlignment="Center" Margin="0,2,0,20"/>

                    <!-- Step Indicator -->
                    <StackPanel Margin="4,0">
                        <TextBlock x:Name="Step1Lbl" Text="1. 설치 위치" Margin="0,4" Foreground="{StaticResource SidebarText}" FontWeight="SemiBold"/>
                        <TextBlock x:Name="Step2Lbl" Text="2. 설치 옵션" Margin="0,4" Foreground="{StaticResource SidebarMuted}"/>
                        <TextBlock x:Name="Step3Lbl" Text="3. 설치 진행" Margin="0,4" Foreground="{StaticResource SidebarMuted}"/>
                        <TextBlock x:Name="Step4Lbl" Text="4. 완료" Margin="0,4" Foreground="{StaticResource SidebarMuted}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Right Wizard Pages -->
            <Grid Grid.Column="1" Margin="20,18">
                <!-- PAGE 1: Welcome & Install Directory -->
                <StackPanel x:Name="Page1" Visibility="Visible">
                    <TextBlock Text="DrawingHelper 설치" FontSize="17" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock Text="컴퓨터에 DrawingHelper를 설치합니다.&#x0a;설치할 폴더를 선택한 뒤 '다음'을 눌러주세요."
                               Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,0,0,20"/>

                    <TextBlock Text="설치 폴더" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="찾아보기..." Click="OnBrowseClick" Margin="6,0,0,0" MinWidth="74" Padding="8,4"/>
                        <TextBox x:Name="TxtInstallDir" VerticalContentAlignment="Center"/>
                    </DockPanel>

                    <TextBlock x:Name="LblSpaceHint" Text="필요 공간: 약 1 MB (사용자 폴더 설치 — 관리자 권한 불필요)"
                               FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,10,0,0"/>
                </StackPanel>

                <!-- PAGE 2: Install Options (Desktop Shortcut, Start Menu, Uninstall Entry) -->
                <StackPanel x:Name="Page2" Visibility="Collapsed">
                    <TextBlock Text="추가 작업 선택" FontSize="17" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock Text="설치 시 함께 생성할 바로가기 및 옵션을 선택하세요."
                               Foreground="{StaticResource TextMuted}" Margin="0,0,0,18"/>

                    <CheckBox x:Name="ChkDesktopShortcut" Content="바탕화면 바로가기 만들기 (Desktop Shortcut)" IsChecked="True"/>
                    <CheckBox x:Name="ChkStartMenu" Content="시작 메뉴 바로가기 만들기" IsChecked="True"/>
                    <CheckBox x:Name="ChkRegisterUninstall" Content="Windows '앱 및 기능'에 제거 정보 등록" IsChecked="True"/>
                </StackPanel>

                <!-- PAGE 3: Installing Progress -->
                <StackPanel x:Name="Page3" Visibility="Collapsed">
                    <TextBlock Text="설치 중..." FontSize="17" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock x:Name="LblProgressStatus" Text="파일을 복사하는 중입니다..."
                               Foreground="{StaticResource TextMuted}" Margin="0,0,0,16"/>

                    <ProgressBar x:Name="ProgressBar" Height="16" Minimum="0" Maximum="100" Value="0"
                                 Foreground="{StaticResource Accent}" Background="#E6E6EC" BorderBrush="{StaticResource BorderLine}"/>

                    <TextBlock x:Name="LblCurrentFile" Text="" FontFamily="Consolas" FontSize="11"
                               Foreground="{StaticResource TextMuted}" Margin="0,10,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <!-- PAGE 4: Finished -->
                <StackPanel x:Name="Page4" Visibility="Collapsed">
                    <TextBlock Text="설치 완료" FontSize="17" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock Text="DrawingHelper 설치가 성공적으로 완료되었습니다."
                               Foreground="{StaticResource TextMuted}" Margin="0,0,0,16"/>

                    <TextBlock x:Name="LblInstalledPath" FontSize="11" Foreground="{StaticResource TextMuted}"
                               TextWrapping="Wrap" Margin="0,0,0,18"/>

                    <CheckBox x:Name="ChkLaunchNow" Content="지금 DrawingHelper 실행" IsChecked="True"/>
                </StackPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
