<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>DrawingHelper</AssemblyName>
    <ApplicationIcon>Assets\app_icon.ico</ApplicationIcon>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app_icon.ico" />
    <Resource Include="Assets\app_icon.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DrawingHelper.Core\DrawingHelper.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\minecraft_palette_rgb.md" Link="minecraft_palette_rgb.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
