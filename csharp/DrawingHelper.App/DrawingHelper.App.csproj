<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>DrawingHelper</AssemblyName>
    <ApplicationIcon>Assets\app_icon.ico</ApplicationIcon>
    <Optimize>true</Optimize>
    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <Product>DrawingHelper</Product>
    <Company>akivilii</Company>
    <Authors>akivilii</Authors>
    <Description>Minecraft pixel-art color matching and 32x32 painting helper.</Description>
    <Copyright>Copyright (c) 2026 akivilii</Copyright>
    <RepositoryUrl>https://github.com/akivilii/drawingHelper</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app_icon.ico" />
    <Resource Include="Assets\app_icon.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DrawingHelper.Core\DrawingHelper.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\minecraft_palette_rgb.md" Link="minecraft_palette_rgb.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
